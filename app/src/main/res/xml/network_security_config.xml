<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production Security: Prohibit cleartext HTTP globally -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Specific domain configurations for AI Studio & Gemini API -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">generativelanguage.googleapis.com</domain>
        <domain includeSubdomains="true">ai.studio</domain>
        <domain includeSubdomains="true">nseindia.com</domain>
        <domain includeSubdomains="true">bseindia.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
